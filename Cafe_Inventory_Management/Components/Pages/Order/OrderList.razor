@page "/orders"
@using Cafe_Inventory_Management.Domain
@using Cafe_Inventory_Management.UI.Services
@inject NavigationManager Navigation
@inject IApiCallService _apiService

<style>
    /* Classic Modern Fusion Palette */
    :root {
        --espresso-deep: #1B1212;
        --latte-cream: #FCF9F6;
        --gold-accent: #C5A059;
        --text-subtle: #6D6D6D;
        --border-soft: #E5E1DA;
    }

    .classic-modern-bg {
        background-color: var(--latte-cream);
        min-height: 100vh;
        padding: 40px;
        font-family: 'Playfair Display', serif;
    }

    .modern-surface {
        background: white !important;
        border-radius: 4px !important;
        border: 1px solid var(--border-soft) !important;
        box-shadow: 0 4px 20px rgba(0,0,0,0.02) !important;
    }

    .header-nav {
        display: flex;
        justify-content: space-between;
        align-items: center;
        margin-bottom: 40px;
        padding-bottom: 20px;
        border-bottom: 1.5px solid var(--espresso-deep);
    }

    .classic-btn-outline {
        border: 1.5px solid var(--espresso-deep) !important;
        color: var(--espresso-deep) !important;
        border-radius: 0 !important;
        font-weight: 700 !important;
        letter-spacing: 1.5px;
        text-transform: uppercase !important;
    }

    .modern-btn-filled {
        background-color: var(--espresso-deep) !important;
        color: white !important;
        border-radius: 0 !important;
        font-weight: 700 !important;
        padding: 10px 25px !important;
    }

    .mud-table-head {
        background-color: #F8F5F2 !important;
    }

    .mud-th {
        color: var(--espresso-deep) !important;
        font-weight: 900 !important;
        font-size: 0.75rem !important;
        text-transform: uppercase;
        letter-spacing: 1px;
    }

    .status-chip-classic {
        font-weight: 800 !important;
        border-radius: 4px !important;
        font-size: 0.7rem !important;
    }
</style>

<div class="classic-modern-bg">
    <MudContainer MaxWidth="MaxWidth.Large">

        <div class="header-nav">
            <MudButton StartIcon="@Icons.Material.Filled.Logout"
                       OnClick="@(() => Navigation.NavigateTo("auth/logout", true))"
                       Class="classic-btn-outline"
                       Variant="Variant.Outlined">
                Logout
            </MudButton>

            <div class="text-center">
                <MudText Typo="Typo.h3" Style="font-weight: 900; color: var(--espresso-deep);">CHANOHOLIC</MudText>
                <MudText Style="letter-spacing: 4px; color: var(--gold-accent); font-weight: 700; font-size: 0.8rem;">
                    EST. 2024 • PREMIUM INVENTORY
                </MudText>
            </div>

            <MudButton Variant="Variant.Filled"
                       Class="modern-btn-filled"
                       StartIcon="@Icons.Material.Filled.Add">
                New Order
            </MudButton>
        </div>

        <MudTable Items="@Orders" Loading="@_loading" Hover="true" Class="modern-surface" Elevation="0">
            <ToolBarContent>
                <MudText Typo="Typo.h6" Style="font-weight: 800; color: var(--espresso-deep);">Recent Transactions</MudText>
                <MudSpacer />
                <MudTextField @bind-Value="_searchString"
                              Placeholder="SEARCH BY REF..."
                              Adornment="Adornment.Start"
                              AdornmentIcon="@Icons.Material.Filled.Search"
                              Variant="Variant.Text"
                              Style="width: 200px;" />
            </ToolBarContent>
            <HeaderContent>
                <MudTh>Reference</MudTh>
                <MudTh>Customer</MudTh>
                <MudTh>Date</MudTh>
                <MudTh>Total Amount</MudTh>
                <MudTh>Order Status</MudTh>
                <MudTh Align="Align.Right">Actions</MudTh>
            </HeaderContent>
            <RowTemplate>
                <MudTd Style="font-weight: 700;">#@context.OrderId</MudTd>
                <MudTd>@context.CustomerName</MudTd>
                <MudTd Style="color: var(--text-subtle);">@context.OrderDate.ToString("MMM dd, HH:mm")</MudTd>
                <MudTd>
                    <MudText Style="font-weight: 900; color: var(--espresso-deep);">$@context.TotalAmount.ToString("N2")</MudText>
                </MudTd>
                <MudTd>
                    <MudChip T="string"
                             Color="@GetStatusColor(context.Status)"
                             Class="status-chip-classic"
                             Variant="Variant.Outlined"
                             Size="Size.Small">
                        @context.Status.ToUpper()
                    </MudChip>
                </MudTd>
                <MudTd Align="Align.Right">
                    <MudIconButton Icon="@Icons.Material.Filled.ReceiptLong" Size="Size.Small" />
                    <MudIconButton Icon="@Icons.Material.Filled.DeleteOutline" Color="Color.Error" Size="Size.Small" />
                </MudTd>
            </RowTemplate>
            <PagerContent>
                <MudTablePager />
            </PagerContent>
        </MudTable>
    </MudContainer>
</div>