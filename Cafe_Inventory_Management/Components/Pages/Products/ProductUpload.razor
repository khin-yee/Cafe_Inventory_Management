@page "/product-import"

<MudStack Row="true" AlignItems="AlignItems.Center" Justify="Justify.SpaceBetween" Class="m-3">
    <MudText Typo="Typo.h5" FontWeight="700" Class="fw-bold">Product Excel Import </MudText>

    <MudStack Row="true" Spacing="2">
        <MudButton Variant="Variant.Outlined" Color="Color.Info"
                   OnClick="PrepareSampleExcel"
                   StartIcon="@Icons.Material.Filled.Download">
            Download Sample Excel
        </MudButton>

        <MudButton HtmlTag="label" Variant="Variant.Filled" Color="Color.Dark"
                   StartIcon="@Icons.Custom.FileFormats.FileExcel" for="excelInput">
            Select Excel File
        </MudButton>
        <InputFile id="excelInput" OnChange="HandleFileSelected" style="display:none" />

        <MudButton Variant="Variant.Filled" Color="Color.Success"
                   Disabled="@(!_previewData.Any())" OnClick="SubmitToDatabase"
                   StartIcon="@Icons.Material.Filled.CloudUpload">
            Confirm & Save to DB
        </MudButton>
    </MudStack>
</MudStack>
@if (!string.IsNullOrWhiteSpace(_sampleExcelDataUrl))
{
    <MudAlert Severity="Severity.Info" Variant="Variant.Outlined" Dense="true" Class="mx-3 mb-2">
        Sample file is ready.
        <a href="@_sampleExcelDataUrl" download="@_sampleFileName" style="margin-left:10px; font-weight:bold;">
            Click here to download
        </a>
    </MudAlert>
}

@* Table to show uploaded data (Read Only) *@
<MudTable Items="@_previewData"
          LoadingProgressColor="Color.Info"
          Dense="true"
          Hover="true"
          Elevation="10"
          RowsPerPage="10"
          Class="rounded-lg overflow-hidden m-2">

    <HeaderContent>
        <MudTh Style="font-weight:bold">Product Name</MudTh>
        <MudTh Style="font-weight:bold">Code</MudTh>
        <MudTh Style="font-weight:bold">Category</MudTh>
        <MudTh Style="font-weight:bold">Quantity</MudTh>
        <MudTh Style="font-weight:bold">Amount</MudTh>
        <MudTh Style="font-weight:bold">IsRecipe</MudTh>
        <MudTh Style="font-weight:bold">Ingredients</MudTh>
    </HeaderContent>
    <RowTemplate>
        <MudTd DataLabel="Name">@context.Product.Name</MudTd>
        <MudTd DataLabel="Code">@context.Product.Code</MudTd>
        <MudTd DataLabel="Category">@context.Product.Category</MudTd>
        <MudTd DataLabel="Quantity">@context.Product.Quatity</MudTd>
        <MudTd DataLabel="Amount">
            <MudText Color="Color.Dark">
                @context.Product.Amount.ToString("N2")MMK
            </MudText>
        </MudTd>
        <MudTd DataLabel="IsRecipe">@context.Product.IsRecipe</MudTd>
        <MudTd DataLabel="Ingredients">@context.Recipe.Count</MudTd>

    </RowTemplate>
    <PagerContent>
        <MudTablePager PageSizeOptions="new int[]{5, 10, 25, 50}" />
    </PagerContent>
    <NoRecordsContent>
        <MudText Typo="Typo.body2" Class="pa-4">No data uploaded yet. Please select an Excel file.</MudText>
    </NoRecordsContent>
</MudTable>
