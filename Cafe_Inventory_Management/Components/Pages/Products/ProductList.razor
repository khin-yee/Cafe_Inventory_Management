@page "/product"
@using Cafe_Inventory_Management.Domain.Model

<MudContainer MaxWidth="MaxWidth.Large" Class="mt-5">
    @* Header Section *@
    <MudStack Row="true" AlignItems="AlignItems.Center" Justify="Justify.SpaceBetween" Class="mb-4">
        <MudText Typo="Typo.h4" Style="font-weight: 700; display: flex; align-items: center;">
            <MudImage Src="/Images/cf1.png" Width="40" Height="40" Alt="Product" Class="mr-3" />
            Product List
        </MudText>
        <MudStack Row="true" Spacing="2">
            @* Add Product Button *@
            <MudButton Variant="Variant.Filled"
            Color="Color.Dark"
            StartIcon="@Icons.Material.Filled.Add"
            Href="/AddProduct"
            Class="rounded-lg px-4">
                Add Product
            </MudButton>

            @* Modern Filter Toggle Button *@
            <MudTooltip Text="@(_showSearch ? "Hide Search" : "Show Search")">
                <MudIconButton Icon="@(_showSearch ? Icons.Material.Filled.FilterListOff : Icons.Material.Filled.FilterList)"
                Color="@(_showSearch ? Color.Primary : Color.Default)"
                Variant="Variant.Outlined"
                OnClick="@(() => _showSearch = !_showSearch)"
                Class="rounded-lg" />
            </MudTooltip>
        </MudStack>
    </MudStack>
    @if (_showSearch)
    {
            <MudGrid Spacing="2" Justify="Justify.Center" Style="align-items: stretch;" Class="mb-2">
                @* Search Box Container *@
                <MudItem xs="12" sm="10" Class="d-flex align-center">
                    <MudTextField @bind-Value="_searchText"
                                  Placeholder="Search by product name..."
                                  Adornment="Adornment.Start"
                                  AdornmentIcon="@Icons.Material.Filled.Search"
                                  Variant="Variant.Outlined"
                                  Margin="Margin.Dense"
                                  Immediate="true"
                                  OnKeyUp="HandleKeyUp"
                                  FullWidth="true"
                                  Class="bg-white rounded-lg" />
                </MudItem>

                @* Search Button Container *@
                <MudItem xs="12" sm="2" Class="d-flex align-center">
                    <MudButton Variant="Variant.Outlined"
                               Color="Color.Dark"
                               FullWidth="true"
                               OnClick="SearchProduct"
                               Style="height: 40px; text-transform: uppercase; font-weight: 600;"
                               >
                        Search
                    </MudButton>
                </MudItem>
            </MudGrid>
    }
    @* Table Section *@
    <MudTable T="Product"
              @ref="@_table"
              ServerData="ServerReload"
              Loading="@_isLoading"
              LoadingProgressColor="Color.Info"
              Dense="true"
              Hover="true"
              Elevation="25"
              Class="rounded-lg overflow-hidden">
        <HeaderContent>
            <MudTh Style="background-color: var(--mud-palette-dark); color: white; text-align: center;">No</MudTh>
            <MudTh Style="background-color: var(--mud-palette-dark); color: white; ">Name</MudTh>
            <MudTh Style="background-color: var(--mud-palette-dark); color: white; ">Quantity</MudTh>
            <MudTh Style="background-color: var(--mud-palette-dark); color: white; ">Amount</MudTh>

            <MudTh Style="background-color: var(--mud-palette-dark); color: white;text-align: right; ">Action</MudTh>
        </HeaderContent>
        <RowTemplate>
            <MudTd DataLabel="No" Style="text-align: center;">
                @if (product != null)
                {
                    @((_table.CurrentPage * _table.RowsPerPage) + (product.IndexOf(context) + 1))
                }
            </MudTd>
            <MudTd DataLabel="Name" Style=" font-weight: 500;">@context.Name</MudTd>
            <MudTd DataLabel="Quantity" >
                <MudChip T="string" Color="Color.Dark" Size="Size.Small" Variant="Variant.Text">@context.Quatity</MudChip>
            </MudTd>
            <MudTd DataLabel="Amount" Style="font-weight: 600;">$@context.Amount</MudTd>
            <MudTd DataLabel="Action" Style="text-align: right;">
                <MudIconButton Icon="@Icons.Material.Filled.Edit" Color="Color.Default" Size="Size.Small" />
                <MudIconButton Icon="@Icons.Material.Filled.Delete"
                               Color="Color.Error"
                               Size="Size.Small"
                               OnClick="@(() => ConfirmDeleteProduct(context.Name))" />
            </MudTd>
        </RowTemplate>
        <PagerContent>
            <MudTablePager PageSizeOptions="new int[]{5, 10, 20}" />
        </PagerContent>
    </MudTable>
</MudContainer>