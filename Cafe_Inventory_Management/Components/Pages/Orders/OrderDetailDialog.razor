@using Cafe_Inventory_Management.Domain.Model

<MudDialog>
    <TitleContent>
        <div class="d-flex align-center justify-space-between pt-2">
            <div class="d-flex align-center">
                <div class="pa-3 rounded-circle mr-4" style="background-color: var(--mud-palette-primary-hover);">
                    <MudIcon Icon="@Icons.Material.Filled.AccessTimeFilled" Color="Color.Primary" />
                </div>
                <div>
                    <div class="d-flex align-center gap-2">
                        <MudText Typo="Typo.h5" FontWeight="FontWeight.Bold">Order Summary</MudText>
                        @* Status moved here, next to the title *@
                        <MudChip T="string" Color="@GetStatusColor(Order.Status)" Variant="Variant.Text"
                                 Icon="@Icons.Material.Filled.Circle" Size="Size.Small" Class="ma-0 px-2 font-weight-bold">
                            @Order.Status
                        </MudChip>
                    </div>
                    <div class="d-flex align-center mt-1">
                        <MudIcon Icon="@Icons.Material.Filled.History" Size="Size.Small" Class="mud-text-secondary mr-1" />
                        <MudText Typo="Typo.subtitle2" Class="mud-text-secondary" Style="letter-spacing: 1px; font-weight: 700;">
                            @Order.CreatedAt.ToString("hh:mm tt").ToUpper()
                        </MudText>
                        <MudDivider Vertical="true" FlexItem="true" Class="mx-2" Style="height: 12px; align-self: center;" />
                        <MudText Typo="Typo.caption" Class="mud-text-secondary">
                            @Order.CreatedAt.ToString("MMM dd, yyyy")
                        </MudText>
                    </div>
                </div>
            </div>
        </div>
    </TitleContent>

    <DialogContent>
        <MudContainer Style="max-height: 600px; overflow-y: auto;" Class="pa-0 mt-4">

            <div class="pa-4 mb-6 rounded-xl d-flex align-center" style="background: var(--mud-palette-drawer-background); border: 1px solid var(--mud-palette-divider);">
                <MudAvatar Color="Color.Primary" Variant="Variant.Filled" Size="Size.Medium" Class="mr-3">
                    @Order.CreatedBy[0].ToString().ToUpper()
                </MudAvatar>
                <div>
                    <MudText Typo="Typo.caption" Class="mud-text-secondary" Style="line-height: 1;">Handled by</MudText>
                    <MudText Typo="Typo.body1" FontWeight="FontWeight.Bold">@Order.CreatedBy</MudText>
                </div>
                <MudSpacer />
                <div class="text-right">
                    <MudText Typo="Typo.caption" Class="mud-text-secondary" Style="line-height: 1;">Total Paid</MudText>
                    <MudText Typo="Typo.h6" Color="Color.Primary" FontWeight="FontWeight.Black">
                        @Order.TotalPrice.ToString("N0") <span style="font-size: 12px;">MMK</span>
                    </MudText>
                </div>
            </div>

            <MudTable Items="Order.Items" T="OrderItems" Hover="false" Elevation="0" Class="mb-4">
                <HeaderContent>
                    <MudTh Style="font-weight: bold; color: var(--mud-palette-text-secondary); border-bottom: 2px solid var(--mud-palette-divider);">PRODUCT</MudTh>
                    <MudTh Style="text-align:center; font-weight: bold; color: var(--mud-palette-text-secondary); border-bottom: 2px solid var(--mud-palette-divider);">QTY</MudTh>
                    <MudTh Style="text-align:right; font-weight: bold; color: var(--mud-palette-text-secondary); border-bottom: 2px solid var(--mud-palette-divider);">SUBTOTAL</MudTh>
                </HeaderContent>
                <RowTemplate>
                    <MudTd>
                        <MudText Typo="Typo.body2" FontWeight="FontWeight.Bold">@context.ProductName</MudText>
                        <MudText Typo="Typo.caption" Class="mud-text-secondary" Style="font-family: monospace;">@context.ProductCode</MudText>
                    </MudTd>
                    <MudTd Style="text-align:center">
                        <MudText Typo="Typo.body2">@context.Quantity</MudText>
                    </MudTd>
                    <MudTd Style="text-align:right">
                        <MudText Typo="Typo.body2" FontWeight="FontWeight.Bold">@((context.Quantity * context.Amount).ToString("N0"))</MudText>
                    </MudTd>
                </RowTemplate>
            </MudTable>

            <div class="d-flex flex-column align-center mt-10 mb-8 mud-text-secondary">
                <MudDivider Style="width: 40%; border-style: dashed;" Class="mb-2" />
                <MudText Typo="Typo.caption" Style="text-transform: uppercase; letter-spacing: 1px;">End of Record</MudText>
            </div>

        </MudContainer>
    </DialogContent>
</MudDialog>

@code {
    [CascadingParameter] public IMudDialogInstance MudDialog { get; set; }
    [Parameter] public OrderViewModel Order { get; set; } = new();

    private Color GetStatusColor(string status) => status?.ToLower() switch
    {
        "success" or "completed" => Color.Success,
        "pending" => Color.Warning,
        "cancelled" => Color.Error,
        _ => Color.Default
    };
}
