@page "/order-history"
@using Cafe_Inventory_Management.Domain.Model
@using Cafe_Inventory_Management.UI.Services
@using Newtonsoft.Json
@using Cafe_Inventory_Management.UI.Components
@inject IApiCallService _apiService
@inject ISnackbar Snackbar

<MudContainer MaxWidth="MaxWidth.ExtraLarge" Class="mt-6">
    <MudPaper Elevation="3" Class="pa-6 rounded-xl">
        <MudGrid Class="mb-4">
            <MudItem xs="12" sm="4">
                <MudStack Row="true" AlignItems="AlignItems.Center">
                    <MudIcon Icon="@Icons.Material.Filled.History" Size="Size.Large" Color="Color.Primary" />
                    <MudStack Spacing="0">
                        <MudText Typo="Typo.h5" FontWeight="700">Order History</MudText>
                        <MudText Typo="Typo.caption" Class="mud-text-secondary">Administrative Reporting</MudText>
                    </MudStack>
                </MudStack>
            </MudItem>

            <MudItem xs="12" sm="8">
                <MudStack Row="true" Spacing="2" Justify="Justify.FlexEnd" AlignItems="AlignItems.Center">
                    <MudDateRangePicker Label="Date Range"
                                        @bind-DateRange="_dateRange"
                                        Margin="Margin.Dense"
                                        Variant="Variant.Outlined"
                                        Clearable="true"
                                     />

                    <MudTextField @bind-Value="_searchString"
                                  Placeholder="Order ID..."
                                  Variant="Variant.Outlined"
                                  Margin="Margin.Dense"
                                  Adornment="Adornment.Start"
                                  AdornmentIcon="@Icons.Material.Filled.Search"
                                   />

                    <MudIconButton Icon="@Icons.Material.Filled.Search"
                                   Variant="Variant.Filled"
                                   Class="px-2"
                                   Color="Color.Primary"
                                   OnClick="PerformSearch"
                                   Size="Size.Medium" />
                </MudStack>
            </MudItem>

            <MudItem xs="12">
                <MudStack Row="true" Spacing="2" Justify="Justify.FlexEnd">
                    <MudButton Variant="Variant.Outlined"
                               Color="Color.Dark"
                               OnClick="@(() => SendManualEmailToAdmin(true))"
                               Disabled="_isEmailing"
                               StartIcon="@Icons.Material.Filled.Email"
                               Style="height: 40px; min-width: 160px;">
                        @(_isEmailing ? "SENDING..." : "EMAIL Montly Report")
                    </MudButton>
                    <MudButton Variant="Variant.Filled"
                               Color="Color.Dark"
                               OnClick="@(() => SendManualEmailToAdmin(false))"
                               Disabled="_isEmailing"
                               StartIcon="@Icons.Material.Filled.Email"
                               Style="height: 40px; min-width: 160px;">
                        @(_isEmailing ? "SENDING..." : "EMAIL Daily Report")
                    </MudButton>
                    <MudButton Variant="Variant.Filled"
                               Color="Color.Tertiary"
                               OnClick="PrepareExcel"
                               Disabled="_isProcessing"
                               StartIcon="@Icons.Material.Filled.Download"
                               Style="height: 40px; min-width: 160px;">
                        @(_isProcessing ? "PREPARING..." : "EXPORT EXCEL")
                    </MudButton>
                </MudStack>
            </MudItem>
        </MudGrid>

        @if (!string.IsNullOrEmpty(_excelDataUrl))
        {
            <MudAlert Severity="Severity.Success" Variant="Variant.Filled" Dense="true" Class="mb-4">
                Report Ready!
                <a href="@_excelDataUrl" download="@_fileName" style="color:white; font-weight:bold; text-decoration:underline; margin-left:10px;">
                    Click here to save file
                </a>
            </MudAlert>
        }

        <MudTable T="OrderViewModel"
                  @ref="_table"
                  ServerData="ServerReload"
                  Hover="true"
                  Dense="true"
                  FixedHeader="true"
                  RowsPerPage="10"
                  Class="border rounded-lg shadow-none">
            <HeaderContent>
                <MudTh>Date & Time</MudTh>
                <MudTh>Order ID</MudTh>
                <MudTh>Status</MudTh>
                <MudTh Align="Right">Total Amount</MudTh>
                <MudTh Align="Right">Action</MudTh>
            </HeaderContent>
            <RowTemplate>
                <MudTd DataLabel="Date">@context.CreatedAt.ToString("dd/MM/yyyy hh:mm tt")</MudTd>
                <MudTd DataLabel="Order ID"><b>#@context.OrderId</b></MudTd>
                <MudTd DataLabel="Status">
                    <MudChip T="string" Color="Color.Success" Size="Size.Small" Variant="Variant.Text">@context.Status</MudChip>
                </MudTd>
                <MudTd DataLabel="Total" Align="Right"><b>@context.TotalPrice.ToString("N0") MMK</b></MudTd>
                <MudTd Align="Right">
                    <MudIconButton Icon="@Icons.Material.Filled.Visibility" Color="Color.Info" OnClick="@(() => ViewDetails(context))" />
                </MudTd>
            </RowTemplate>
            <PagerContent>
                <MudTablePager PageSizeOptions="new int[]{10, 25, 50}" />
            </PagerContent>
        </MudTable>
    </MudPaper>
</MudContainer>