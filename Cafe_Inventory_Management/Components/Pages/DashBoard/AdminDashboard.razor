@page "/admin-dashboard"
@using Cafe_Inventory_Management.UI.Services
@using Newtonsoft.Json
@inject IApiCallService _apiService

<MudContainer MaxWidth="MaxWidth.ExtraLarge" Class="mt-4 px-8">
    <MudStack Row="true" Justify="Justify.SpaceBetween" AlignItems="AlignItems.End" Class="mb-8">
        <MudStack Spacing="0">
            <MudText Typo="Typo.h4" FontWeight="900" Style="letter-spacing: -1px; color: #1A1C1E;">Intelligence Center</MudText>
            <MudText Typo="Typo.body2" Style="color: #6D7175;">System Health • @DateTime.Now.ToString("dddd, MMMM dd")</MudText>
        </MudStack>

        <MudPaper Elevation="0" Class="pa-1 rounded-pill border border-solid mud-border-lines-default" Style="background: #F1F2F4;">
            <MudToggleGroup T="string" Value="@_staffRange" ValueChanged="OnStaffRangeChanged"
                            Outline="false" Delimiters="false" Dense="true" CheckMark="false" Color="Color.Primary">
                <MudToggleItem Value="@("today")" Class="rounded-pill px-6">Day</MudToggleItem>
                <MudToggleItem Value="@("7d")" Class="rounded-pill px-6">Week</MudToggleItem>
                <MudToggleItem Value="@("month")" Class="rounded-pill px-6">Month</MudToggleItem>
            </MudToggleGroup>
        </MudPaper>
    </MudStack>

    <MudGrid Spacing="6">
        <MudItem xs="12" lg="9">
            <MudStack Spacing="6">

                <MudPaper Elevation="0" Class="pa-6 rounded-xl border border-solid mud-border-lines-default" Style="background: #FFFFFF;">
                    <MudStack Row="true" AlignItems="AlignItems.Center" Justify="Justify.SpaceBetween" Class="mb-6">
                        <MudStack Row="true" AlignItems="AlignItems.Center" Spacing="3">
                            <div style="width: 12px; height: 12px; border-radius: 3px; background: var(--mud-palette-primary);"></div>
                            <MudText Typo="Typo.h6" FontWeight="FontWeight.Bold">Operational Performance</MudText>
                        </MudStack>
                    </MudStack>

                    <MudTable Items="_staffPerformance"  Hover="true" Elevation="0" Loading="_isStaffLoading" Class="custom-business-table">
                        <HeaderContent>
                            <MudTh Style="font-weight: 700; font-size: 0.75rem; color: #6D7175;">STAFF IDENTITY</MudTh>
                            <MudTh Style="font-weight: 700; font-size: 0.75rem; color: #6D7175; text-align:center;">VOLUME</MudTh>
                            <MudTh Style="font-weight: 700; font-size: 0.75rem; color: #6D7175; text-align:right;">GROSS REVENUE</MudTh>
                            <MudTh Style="font-weight: 700; font-size: 0.75rem; color: #6D7175; text-align:right;">PERFORMANCE</MudTh>
                        </HeaderContent>
                        <RowTemplate>
                            <MudTd>
                                <MudStack Row="true" AlignItems="AlignItems.Center" Spacing="3">
                                    <MudAvatar Color="Color.Primary" Variant="Variant.Text" Style="font-weight: 700;">@context.StaffName[0]</MudAvatar>
                                    <MudText Typo="Typo.body2" FontWeight="FontWeight.Bold">@context.StaffName</MudText>
                                </MudStack>
                            </MudTd>
                            <MudTd Style="text-align:center;">
                                <MudChip T="string" Size="Size.Small" Variant="Variant.Outlined" Class="font-weight-bold">@context.TotalOrdersHandled Orders</MudChip>
                            </MudTd>
                            <MudTd Style="text-align:right;">
                                <MudText Typo="Typo.body2" FontWeight="FontWeight.Black">@context.TotalRevenueGenerated.ToString("N0") <span style="font-size: 10px; color: #919191;">MMK</span></MudText>
                            </MudTd>
                            <MudTd Style="text-align:right; width: 180px;">
                                <MudStack Spacing="1" AlignItems="AlignItems.End">
                                    <MudProgressLinear Color="Color.Primary" Value="@CalculateProgress(context.TotalOrdersHandled)" Height="6" Class="rounded-pill" Style="width: 100px; background: #F1F2F4;" />
                                    <MudText Typo="Typo.caption" Style="font-size: 10px;">Relative Efficiency: @CalculateProgress(context.TotalOrdersHandled).ToString("F0")%</MudText>
                                </MudStack>
                            </MudTd>
                        </RowTemplate>
                    </MudTable>
                </MudPaper>

                <MudPaper Elevation="0" Class="pa-6 rounded-xl border border-solid mud-border-lines-default" Style="background: #FFFFFF;">
                    <MudStack Row="true" AlignItems="AlignItems.Center" Class="mb-4">
                        <MudIcon Icon="@Icons.Material.Filled.Inventory2" Color="Color.Dark" Size="Size.Small" />
                        <MudText Typo="Typo.subtitle1" FontWeight="FontWeight.Bold">Critical Inventory Alerts</MudText>
                    </MudStack>
                    <MudGrid Spacing="2">
                        @foreach (var item in _adminData.LowStockItems)
                        {
                            <MudItem xs="12" md="4">
                                <MudPaper Elevation="0" Class="pa-3 rounded-lg border border-solid mud-border-lines-default d-flex justify-space-between align-center">
                                    <div>
                                        <MudText Typo="Typo.caption" Class="mud-text-secondary">@item.Category</MudText>
                                        <MudText Typo="Typo.body2" FontWeight="FontWeight.Bold">@item.Name</MudText>
                                    </div>
                                    <div class="text-right">
                                        <MudText Typo="Typo.body2" Color="Color.Error" FontWeight="FontWeight.Bold">@item.CurrentStock Units</MudText>
                                        <MudText Typo="Typo.caption" Style="text-decoration: underline; cursor: pointer; color: var(--mud-palette-primary);">Order</MudText>
                                    </div>
                                </MudPaper>
                            </MudItem>
                        }
                    </MudGrid>
                </MudPaper>
            </MudStack>
        </MudItem>

        <MudItem xs="12" lg="3">
            <MudStack Spacing="6">
                <MudPaper Elevation="0" Class="pa-6 rounded-xl border border-solid border-primary" Style="background: #E8F0FE;">
                    <MudText Typo="Typo.subtitle2" Color="Color.Primary" FontWeight="FontWeight.Bold" Class="mb-1">SYSTEM STATUS</MudText>
                    <MudText Typo="Typo.h5" FontWeight="FontWeight.Black" Style="color: #1A73E8;">Operational</MudText>
                    <MudText Typo="Typo.caption" Style="color: #555;">All services are reporting healthy.</MudText>
                </MudPaper>

                <MudPaper Elevation="0" Class="pa-6 rounded-xl border border-solid mud-border-lines-default" Style="background: #FFFFFF;">
                    <MudText Typo="Typo.subtitle1" FontWeight="FontWeight.Bold" Class="mb-4">Audit Trail</MudText>
                    <div style="max-height: 400px; overflow-y: auto;">
                        @foreach (var activity in _adminData.RecentActivities)
                        {
                            <div class="mb-5 d-flex gap-3">
                                <div style="min-width: 4px; height: 35px; border-radius: 2px; background: #D1D5DB;"></div>
                                <div>
                                    <MudText Typo="Typo.caption" Class="mud-text-secondary">@activity.Time.ToString("HH:mm") • @activity.User</MudText>
                                    <MudText Typo="Typo.body2" Style="color: #374151; font-weight: 500;">@activity.Action</MudText>
                                </div>
                            </div>
                        }
                    </div>
                </MudPaper>
            </MudStack>
        </MudItem>
    </MudGrid>
</MudContainer>

<style>
    .custom-business-table .mud-table-head {
        background-color: #FAFAFA;
    }

    .custom-business-table .mud-table-container {
        border-radius: 8px;
    }

    .mud-typography-h4 {
        font-family: 'Inter', 'Segoe UI', sans-serif !important;
    }
</style>