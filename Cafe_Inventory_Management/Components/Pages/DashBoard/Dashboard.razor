@page "/dashboard"
@using Cafe_Inventory_Management.UI.Services
@using Newtonsoft.Json
@inject IApiCallService _apiService

<MudContainer MaxWidth="MaxWidth.ExtraLarge" Class="mt-8">
    <div class="d-flex justify-space-between align-center mb-6">
        <MudText Typo="Typo.h4"  class="me-4" FontWeight="700">Business Intelligence</MudText>

        <MudSelect T="string" Label="Time Range" Value="@_selectedRange" ValueChanged="OnRangeChanged"
              Variant="Variant.Outlined" Margin="Margin.Dense" Style="width: 150px; background: white;">
            <MudSelectItem Value="@("7d")">Last 7 Days</MudSelectItem>
            <MudSelectItem Value="@("month")">This Month</MudSelectItem>
            <MudSelectItem Value="@("year")">This Year</MudSelectItem>
        </MudSelect>
    </div>

    @if (_isLoading)
    {
        <MudProgressLinear Color="Color.Primary" Indeterminate="true" Class="my-7" />
    }
    else
    {
        <MudGrid>
            <MudItem xs="12" sm="6" md="3">
                <MudPaper Class="pa-4 rounded-xl shadow-sm border-l-8" Style="border-color: #594AE2;">
                    <MudText Typo="Typo.subtitle2" Class="mud-text-secondary">Total Revenue</MudText>
                    <MudText Typo="Typo.h5" FontWeight="700">@_stats.TotalSales.ToString("N0") MMK</MudText>
                </MudPaper>
            </MudItem>

            <MudItem xs="12" sm="6" md="3">
                <MudPaper Class="pa-4 rounded-xl shadow-sm border-l-8" Style="border-color: #00C853;">
                    <MudText Typo="Typo.subtitle2" Class="mud-text-secondary">Orders Completed</MudText>
                    <MudText Typo="Typo.h5" FontWeight="700">@_stats.TotalOrders.ToString("N0")</MudText>
                </MudPaper>
            </MudItem>

            <MudItem xs="12" sm="6" md="3">
                <MudPaper Class="pa-4 rounded-xl shadow-sm border-l-8" Style="border-color: #FF9800;">
                    <MudText Typo="Typo.subtitle2" Class="mud-text-secondary">Today's Sales</MudText>
                    <MudText Typo="Typo.h5" FontWeight="700">@_stats.TodaySales.ToString("N0") MMK</MudText>
                </MudPaper>
            </MudItem>

            <MudItem xs="12" sm="6" md="3">
                <MudPaper Class="pa-4 rounded-xl shadow-sm border-l-8" Style="border-color: #FF4081;">
                    <MudText Typo="Typo.subtitle2" Class="mud-text-secondary">Avg. Order Value</MudText>
                    <MudText Typo="Typo.h5" FontWeight="700">@_stats.AvgOrderValue.ToString("N0") MMK</MudText>
                </MudPaper>
            </MudItem>

            <MudItem xs="12" md="8">
                <MudPaper Class="pa-6 rounded-xl shadow-sm">
                    <MudText Typo="Typo.h6" Class="mb-4">Revenue Trend</MudText>
                    <MudChart ChartType="ChartType.Bar"
                              ChartSeries="@_series"
                              XAxisLabels="@_stats.ChartLabels"
                              Width="100%" Height="350px" />
                </MudPaper>
            </MudItem>

            <MudItem xs="12" md="4">
                <MudPaper Class="pa-6 rounded-xl shadow-sm">
                    <MudText Typo="Typo.h6" Class="mb-4">Sales by Category</MudText>
                    @if (_pieData.Length > 0)
                    {
                        <MudChart ChartType="ChartType.Donut"
                                  InputData="@_pieData"
                                  InputLabels="@_pieLabels"
                                  Width="100%" Height="300px" />
                    }
                    else
                    {
                        <div class="d-flex align-center justify-center" style="height:300px">
                            <MudText Color="Color.Secondary">No category data found</MudText>
                        </div>
                    }
                </MudPaper>
            </MudItem>

            <MudItem xs="12">
                <MudPaper Class="pa-6 rounded-xl shadow-sm">
                    <MudText Typo="Typo.h6" Class="mb-4">Top 5 Selling Products</MudText>
                    <MudTable Items="_stats.TopProducts" Dense="true" Hover="true" Elevation="0">
                        <HeaderContent>
                            <MudTh>Product Name</MudTh>
                            <MudTh>Quantity Sold</MudTh>
                            <MudTh>Action</MudTh>
                        </HeaderContent>
                        <RowTemplate>
                            <MudTd>@context.ProductName</MudTd>
                            <MudTd><b>@context.TotalQty</b></MudTd>
                            <MudTd>
                                <MudChip T="string" Color="Color.Success" Size="Size.Small">Best Seller</MudChip>
                            </MudTd>
                        </RowTemplate>
                    </MudTable>
                </MudPaper>
            </MudItem>
        </MudGrid>
    }
    </MudContainer>