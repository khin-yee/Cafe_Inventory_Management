@page "/"
@using Microsoft.AspNetCore.Components.Authorization
@inject NavigationManager Navigation

<style>
    .login-root {
        height: 100vh;
        width: 100vw;
        display: flex;
        align-items: center;
        justify-content: center;
        background-image: url('/Images/login_bg_warm.png');

        background-size: cover;
        background-position: center;
        position: relative;
        overflow: hidden;
        font-family: 'Inter', 'Segoe UI', sans-serif;
    }

    .login-overlay {
        position: absolute;
        top: 0; left: 0; right: 0; bottom: 0;
        background: linear-gradient(135deg, rgba(17, 24, 39, 0.4) 0%, rgba(17, 24, 39, 0.2) 100%);
        z-index: 1;
    }


    .login-container {
        position: relative;
        z-index: 2;
        width: 100%;
        max-width: 480px;
        padding: 20px;
        animation: fadeInScale 0.8s cubic-bezier(0.16, 1, 0.3, 1);
    }

    @@keyframes fadeInScale {
        from { opacity: 0; transform: scale(0.95) translateY(20px); }
        to { opacity: 1; transform: scale(1) translateY(0); }
    }

    .glass-card {
        background: rgba(255, 255, 255, 0.05) !important;
        backdrop-filter: blur(25px) saturate(150%);
        -webkit-backdrop-filter: blur(25px) saturate(150%);
        border: 1px solid rgba(255, 255, 255, 0.1) !important;
        border-radius: 24px !important;
        box-shadow: 0 25px 50px -12px rgba(0, 0, 0, 0.5) !important;
        padding: 48px !important;
    }

    .brand-section {
        text-align: center;
        margin-bottom: 40px;
    }

    .brand-logo-container {
        width: 80px;
        height: 80px;
        background: white;
        border-radius: 50%;
        display: flex;
        align-items: center;
        justify-content: center;
        margin: 0 auto 20px;
        box-shadow: 0 12px 20px -5px rgba(0, 0, 0, 0.3);
        border: 2px solid rgba(255,255,255,0.8);
    }



    .login-title {
        color: white;
        font-weight: 800;
        letter-spacing: -0.5px;
        font-size: 2rem;
        margin-bottom: 8px;
    }

    .login-subtitle {
        color: rgba(255, 255, 255, 0.6);
        font-size: 0.875rem;
    }

    /* Input overrides for dark glass */
    .glass-input input {
        color: white !important;
    }
    .glass-input label {
        color: rgba(255, 255, 255, 0.5) !important;
    }
    .glass-input .mud-input-outlined-border {
        border-color: rgba(255, 255, 255, 0.2) !important;
    }
    .glass-input:hover .mud-input-outlined-border {
        border-color: rgba(255, 255, 255, 0.4) !important;
    }
    .glass-input.mud-input-focus .mud-input-outlined-border {
        border-color: var(--mud-palette-primary) !important;
    }
    .glass-input .mud-input-adornment-icon {
        color: rgba(255, 255, 255, 0.5) !important;
    }

    .action-btn {
        height: 56px;
        border-radius: 12px;
        font-weight: 700;
        font-size: 1rem;
        text-transform: none;
        letter-spacing: 0.5px;
        transition: all 0.2s ease;
        background: white !important;
        color: #111827 !important;
    }

    .action-btn:hover {
        transform: translateY(-2px);
        box-shadow: 0 10px 15px -3px rgba(0, 0, 0, 0.1);
        background: rgba(255,255,255,0.9) !important;
    }

    .action-btn:active {
        transform: translateY(0);
    }
</style>

<div class="login-root">
    <div class="login-overlay"></div>

    <div class="login-container">
        <MudPaper Elevation="0" Class="glass-card">
            
            <div class="brand-section">
                <div class="brand-logo-container">
                    <MudIcon Icon="@Icons.Material.Filled.LocalCafe" Color="Color.Primary" Size="Size.Large" />
                </div>

                <MudText Typo="Typo.h4" Class="login-title">CHANOHOLIC</MudText>
                <MudText Typo="Typo.body2" Class="login-subtitle">CAFE INVENTORY MANAGEMENT SYSTEM</MudText>
            </div>

            @if (!string.IsNullOrEmpty(Error))
            {
                <MudAlert Severity="Severity.Error" Variant="Variant.Filled" Dense="true" Class="mb-6 rounded-lg">
                    @Error
                </MudAlert>
            }

            <MudStack Spacing="4">
                <MudTextField @bind-Value="Username"
                              Label="Email Address"
                              Variant="Variant.Outlined"
                              Adornment="Adornment.Start"
                              AdornmentIcon="@Icons.Material.Filled.Email"
                              Class="glass-input" />

                <MudTextField @bind-Value="Password"
                              Label="Password"
                              Variant="Variant.Outlined"
                              InputType="InputType.Password"
                              Adornment="Adornment.Start"
                              AdornmentIcon="@Icons.Material.Filled.Lock"
                              Class="glass-input" />

                <div class="mt-4">
                    <MudButton FullWidth="true"
                               Variant="Variant.Filled"
                               Class="action-btn"
                               OnClick="HandleLogin"
                               Disabled="IsLoading">
                        @if (IsLoading)
                        {
                            <MudProgressCircular Size="Size.Small" Indeterminate="true" Class="mr-2" Color="Color.Dark" />
                            <span>Authenticating...</span>
                        }
                        else
                        {
                            <span>Sign In</span>
                        }
                    </MudButton>
                </div>
            </MudStack>

            <div class="mt-8 text-center">
                <MudText Typo="Typo.caption" Style="color: rgba(255,255,255,0.3);">
                    &copy; @DateTime.Now.Year Chanoholic. Professional Inventory Control.
                </MudText>
            </div>

        </MudPaper>
    </div>
</div>