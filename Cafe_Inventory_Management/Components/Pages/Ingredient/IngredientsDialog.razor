@using Cafe_Inventory_Management.Domain
@using Cafe_Inventory_Management.Domain.Model
@using Cafe_Inventory_Management.UI.Services
@using MudBlazor
@inject IApiCallService ApiService

<MudDialog FullWidth="true" Class="rounded-xl p-3" Style="max-width: 500px;">
    <DialogContent>
        <MudStack Spacing="3">
            @* Ingredients Name *@
            <MudTextField Label="Ingredients Name"
                          Margin="Margin.Dense"
                          Variant="Variant.Outlined"
                          Adornment="Adornment.Start"
                          AdornmentIcon="@Icons.Material.Filled.Inventory"
                          @bind-Value="Model.Name"
                          Required />

            <MudTextField Label="Ingredients Code"
                          Margin="Margin.Dense"
                          Variant="Variant.Outlined"
                          Adornment="Adornment.Start"
                          AdornmentIcon="@Icons.Material.Filled.Inventory"
                          @bind-Value="Model.Code"
                          Required />
            @* Category Dropdown *@
            <MudSelect T="string"
                       Label="Category"
                       Variant="Variant.Outlined"
                       Margin="Margin.Dense"
                       @bind-Value="Model.Unit"
                       AdornmentIcon="@Icons.Material.Filled.Category"
                       Required>
                @if (_categories != null)
                {
                    @foreach (var cat in _categories)
                    {
                        <MudSelectItem Value="@cat">@cat</MudSelectItem>
                    }
                }
            </MudSelect>

            <MudGrid>
                
                <MudItem xs="6">
                    <MudNumericField Label="Quatity"
                                     Variant="Variant.Outlined"
                                     Margin="Margin.Dense"
                                     Min=1
                                     @bind-Value="Model.Quatity"
                                     Required />
                </MudItem>
                <MudItem xs="6">
                    <MudNumericField Label="Amount"
                                     Variant="Variant.Outlined"
                                     Margin="Margin.Dense"
                                     Adornment="Adornment.Start"
                                     AdornmentText="$"
                                     @bind-Value="Model.Amount"
                                     Required />
                </MudItem>
            </MudGrid>
            <MudPaper Elevation="0" Class="pa-2 d-flex align-center justify-space-between" Style="background: transparent; border: 1px solid #e0e0e0; border-radius: 8px;">
                <MudText Typo="Typo.body1">Ingredients Availability</MudText>
                <MudSwitch @bind-Value="Model.IsActive"
                           Color="Color.Success"
                           UnCheckedColor="Color.Error"
                           Label="@(Model.IsActive ? "Active" : "Inactive")" />
            </MudPaper>
        </MudStack>
    </DialogContent>

    <DialogActions>
        <MudButton Variant="Variant.Outlined"
                   Size="Size.Small"
                   Color="Color.Dark"
                   OnClick="Cancel">
            Cancel
        </MudButton>
        <MudButton Variant="Variant.Filled"
                   Size="Size.Small"
                   Color="Color.Primary"
                   OnClick="Save">
            @(IsEdit ? "Update Ingredients" : "Create Ingredients")
        </MudButton>
    </DialogActions>
</MudDialog>

@code {
    [CascadingParameter] public IMudDialogInstance MudDialog { get; set; }

    [Parameter] public Ingredients Model { get; set; } = new();
    [Parameter] public bool IsEdit { get; set; }
    [Inject] private ISnackbar Snackbar { get; set; }
    private List<string> _categories = new();

    protected override async Task OnInitializedAsync()
    {
        // Fetch categories from API to populate the dropdown
        await LoadCategories();

        if (!IsEdit)
        {
            Model = new Ingredients(); // Ensure fresh object for new entry
        }
    }

    private async Task LoadCategories()
    {

        _categories = new List<string> { "Kg", "g", "Pack", "Liter" };

        // try
        // {
        //     // Update this URL to your actual Category endpoint
        //     var request = new ApiRequest(HttpMethod.Get, "/Category", "", "");
        //     var response = await ApiService.APICall(request);

        //     if (response.ErrorCode == "00")
        //     {
        //         // Assuming your category API returns a list of names or objects
        //         _categories = Newtonsoft.Json.JsonConvert.DeserializeObject<List<string>>(response.Detail);
        //     }
        // }
        // catch (Exception ex)
        // {
        //     Console.WriteLine($"Error loading categories: {ex.Message}");
        //     // Fallback static categories if API fails
        //     _categories = new List<string> { "Coffee", "Juice", "Snack", "Bakery" };
        // }
    }

    // Inside IngredientsDialog.razor @code block
    private bool _isSaving = false;

    async Task Save()
    {
        if (string.IsNullOrWhiteSpace(Model.Name)) return;

        _isSaving = true;
        try
        {
            var method = IsEdit ? HttpMethod.Put : HttpMethod.Post;
            var url = IsEdit ? $"/UpdateIngredients" : "/CreateIngredients";

            var request = new ApiRequest(method, url, Model, "");
            var response = await ApiService.APICall(request);

            if (response.ErrorCode == "00")
            {
                string message = IsEdit ? "Ingredients updated successfully!" : "Ingredients created successfully!";
                Snackbar.Add(message, Severity.Success);

                MudDialog.Close(DialogResult.Ok(true));
            }

            else
            {
                Snackbar.Add(response.ErrorMessage, Severity.Error);
            }
        }
        catch (Exception ex)
        {
            Console.WriteLine(ex.Message);
        }
        finally
        {
            _isSaving = false;
        }
    }

    void Cancel() => MudDialog.Cancel();
}