@page "/ingredient-import"
    @inject NavigationManager Nav

<MudPaper Elevation="3" Class="pa-6 rounded-xl mb-4">
    <MudStack Row="true" AlignItems="AlignItems.Center" Justify="Justify.SpaceBetween">
        <MudStack Spacing="0">
            <MudText Typo="Typo.h5" FontWeight="700">Ingredients Excel Import</MudText>
            <MudText Typo="Typo.caption" Class="mud-text-secondary">Batch stock management</MudText>
        </MudStack>

        <MudStack Row="true" Spacing="2">
            <MudButton Variant="Variant.Outlined" Color="Color.Info"
                       OnClick="PrepareSampleExcel"
                       StartIcon="@Icons.Material.Filled.Download"
                       Class="rounded-lg">
                Sample
            </MudButton>

            <MudButton HtmlTag="label" Variant="Variant.Filled" Color="Color.Primary"
                       StartIcon="@Icons.Custom.FileFormats.FileExcel" for="excelInput"
                       Class="rounded-lg">
                Select File
            </MudButton>
            <InputFile id="excelInput" OnChange="HandleFileSelected" style="display:none" />

            <MudButton Variant="Variant.Filled" Color="Color.Success"
                       Disabled="@(!_previewData.Any())" OnClick="SubmitToDatabase"
                       StartIcon="@Icons.Material.Filled.CloudUpload"
                       Class="rounded-lg px-6">
                Save to Database
            </MudButton>
        </MudStack>
    </MudStack>
</MudPaper>

@if (!string.IsNullOrWhiteSpace(_sampleExcelDataUrl))
{
    <MudAlert Severity="Severity.Info" Variant="Variant.Outlined" Dense="true" Class="mx-3 mb-2">
        Sample file is ready.
        <a href="@_sampleExcelDataUrl" download="@_sampleFileName" style="margin-left:10px; font-weight:bold;">
            Click here to download
        </a>
    </MudAlert>
}

@* Table to show uploaded data (Read Only) *@
<MudTable Items="@_previewData"           
              LoadingProgressColor="Color.Info"
              Dense="true"
              Hover="true"
              Elevation="10"
          RowsPerPage="10"
              Class="rounded-lg overflow-hidden m-2">

    <HeaderContent>
        <MudTh Style="font-weight:bold">Ingredient Name</MudTh>
        <MudTh Style="font-weight:bold">Code</MudTh>
        <MudTh Style="font-weight:bold">Unit</MudTh>
        <MudTh Style="font-weight:bold">Quantity</MudTh>
        <MudTh Style="font-weight:bold">Amount</MudTh>
    </HeaderContent>
    <RowTemplate>
        <MudTd DataLabel="Name">@context.Name</MudTd>
        <MudTd DataLabel="Code">@context.Code</MudTd>
        <MudTd DataLabel="Unit">@context.Unit</MudTd>
        <MudTd DataLabel="Quantity">@context.Quantity</MudTd>
        <MudTd DataLabel="Amount">
            <MudText Color="Color.Dark" >
                @context.Amount.ToString("N2")MMK
            </MudText>
        </MudTd>
    </RowTemplate>
    <PagerContent>
        <MudTablePager PageSizeOptions="new int[]{5, 10, 25, 50}" />
    </PagerContent>
    <NoRecordsContent>
        <MudStack AlignItems="AlignItems.Center" Class="pa-12">
            <MudIcon Icon="@Icons.Custom.FileFormats.FileExcel" Size="Size.Large" Color="Color.Default" Style="opacity: 0.2;" />
            <MudText Typo="Typo.body1" Class="mud-text-secondary">No data uploaded yet. Select an Excel file to preview.</MudText>
        </MudStack>
    </NoRecordsContent>

</MudTable>
