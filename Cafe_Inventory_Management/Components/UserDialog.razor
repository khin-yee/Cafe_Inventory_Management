@using Cafe_Inventory_Management.Domain
@using Cafe_Inventory_Management.UI.Services
@using MudBlazor
@inject AuthServices AuthService


<MudDialog FullWidth="true" Class="rounded-xl" Style="max-width: 500px;">
    <TitleContent>
        <MudStack Row="true" AlignItems="AlignItems.Center" Class="pa-4 pb-0">
            <MudAvatar Color="Color.Primary" Variant="Variant.Filled" Size="Size.Medium">
                <MudIcon Icon="@(IsEdit ? Icons.Material.Filled.Edit : Icons.Material.Filled.PersonAdd)" />
            </MudAvatar>
            <MudText Typo="Typo.h5" FontWeight="700">
                @(IsEdit ? "Update Staff User" : "Create New Staff")
            </MudText>
        </MudStack>
    </TitleContent>
    <DialogContent>
        <div class="pa-6">


        <MudStack Spacing="3">


            <!-- FORM -->

            <MudTextField Label="Email Address" 
            Margin="Margin.Dense"
            Variant="Variant.Outlined"
            Adornment="Adornment.Start"
            AdornmentIcon="@Icons.Material.Filled.Email"
            @bind-Value="Email"
            Required />

            <MudTextField Label="Full Name" 
            Variant="Variant.Outlined"
            Margin="Margin.Dense"
            Adornment="Adornment.Start"
            AdornmentIcon="@Icons.Material.Filled.Person"
            @bind-Value="Name"
            Required />

            <MudSelect T="string"
            Label="Role"
            Variant="Variant.Outlined"
            Margin="Margin.Dense"
            @bind-Value="SelectedRole"
            Required>

                <MudSelectItem Value="Admin">Admin</MudSelectItem>
                <MudSelectItem Value="Staff">Staff</MudSelectItem>

            </MudSelect>


            @if (!IsEdit)
            {
                <MudTextField Label="Password" Dense="true"
                Variant="Variant.Outlined"
                InputType="InputType.Password"
                Margin="Margin.Dense"
                Adornment="Adornment.Start"
                AdornmentIcon="@Icons.Material.Filled.Lock"
                @bind-Value="Password"
                Required />
            }

        </MudStack>

            @if (!string.IsNullOrEmpty(_errorMessage))
            {
                <MudAlert Severity="Severity.Error" Dense="true" Class="mt-3 rounded-lg" ShowCloseIcon="true" CloseIconClicked="() => _errorMessage = null">
                    @_errorMessage
                </MudAlert>
            }
        </div>
    </DialogContent>



    <DialogActions>
        <div class="pa-4 d-flex justify-end gap-3 w-100">
            <MudButton Variant="Variant.Text" OnClick="Cancel">Cancel</MudButton>
            <MudButton Variant="Variant.Filled"
                       Color="Color.Primary"
                       OnClick="Save"
                       Class="px-8 rounded-pill"
                       Disabled="_isSaving">
                @if (_isSaving)
                {
                    <MudProgressCircular Size="Size.Small" Indeterminate="true" Class="mr-2" />
                }
                @(IsEdit ? "Update" : "Create")
            </MudButton>
        </div>
    </DialogActions>
</MudDialog>


@code {







    [CascadingParameter]
    public IMudDialogInstance MudDialog { get; set; }

    public string SelectedRole = "Staff"; // Default

    public string Admin = "Admin";

    public string Staff = "Staff";

    [Parameter] public Auth0User? User { get; set; }

    [Parameter] public bool IsEdit { get; set; }


    string Email = "";
    string Name = "";
    string Password = "";


    protected override void OnInitialized()
    {
        if (IsEdit && User != null)
        {
            Email = User.email;
            Name = User.name;

            if (User.roles != null && User.roles.Any())
            {
                SelectedRole = User.roles.First();
            }
        }
    }


    private bool _isSaving = false;
    private string? _errorMessage = null;

    async Task Save()
    {
        if (string.IsNullOrWhiteSpace(Email) ||
            string.IsNullOrWhiteSpace(Name) ||
            string.IsNullOrWhiteSpace(SelectedRole))
        {
            _errorMessage = "Please fill in all required fields (Email, Name, and Role).";
            if (!IsEdit && string.IsNullOrWhiteSpace(Password))
                _errorMessage = "Please fill in all required fields including Password.";
            return;
        }

        if (!IsEdit && string.IsNullOrWhiteSpace(Password))
        {
            _errorMessage = "Password is required when creating a new user.";
            return;
        }

        _isSaving = true;
        _errorMessage = null;
        try
        {
            if (IsEdit)
            {
                await AuthService.UpdateUser(User!.user_id, Email, Name);
                await AuthService.AssignRole(User.user_id, SelectedRole);
            }
            else
            {
                var newUserId = await AuthService.CreateUser(Email, Password, Name);
                await AuthService.AssignRole(newUserId, SelectedRole);
            }
            MudDialog.Close(DialogResult.Ok(true));
        }
        catch (Exception ex)
        {
            _errorMessage = ex.Message;
        }
        finally
        {
            _isSaving = false;
        }
    }

    void Cancel() => MudDialog.Cancel();
}
