<MudNavMenu Dense="true">
    <MudNavLink Href="/pos" Icon="@Icons.Material.Filled.PointOfSale">Point of Sale</MudNavLink>

    <!-- Orders -->
    <MudNavGroup Title="Orders" Ripple="true" Class="py-3 mt-1"
                 Icon="@Icons.Material.Filled.ReceiptLong"
                 ExpandIcon="@Icons.Material.Filled.ExpandMore"
                 CollapseIcon="@Icons.Material.Filled.ExpandLess">

        <MudNavLink Href="/orders">Order Management</MudNavLink>
        <MudNavLink Href="/ordersList">Order List</MudNavLink>
        <MudNavLink Href="/order-history">Order History</MudNavLink>

    </MudNavGroup>

    <!-- Products -->
    <MudNavGroup title="Products" Ripple="true" Class="py-3"
                 Icon="@Icons.Material.Filled.LocalCafe"
                 ExpandIcon="@Icons.Material.Filled.ExpandMore"
                 CollapseIcon="@Icons.Material.Filled.ExpandLess">

        <MudNavLink Href="/product">Product List</MudNavLink>
        <MudNavLink Href="/product-import">Products Import</MudNavLink>

    </MudNavGroup>

    <!-- Ingredients -->
    <MudNavGroup Title="Ingredients" Ripple="true" Class="py-3"
                 Icon="@Icons.Material.Filled.Inventory"
                 ExpandIcon="@Icons.Material.Filled.ExpandMore"
                 CollapseIcon="@Icons.Material.Filled.ExpandLess">

        <MudNavLink Href="/Ingredients">Stock Control</MudNavLink>
        <MudNavLink Href="/ingredient-import">Ingredients Import</MudNavLink>

    </MudNavGroup>

    <MudDivider Class="my-2" />

    <!-- Admin -->
    <AuthorizeView Roles="Admin">
        <Authorized>

            <MudNavGroup title="Administrations" Ripple="true" Class="py-3"
                         Icon="@Icons.Material.Filled.AdminPanelSettings"
                         ExpandIcon="@Icons.Material.Filled.ExpandMore"
                         CollapseIcon="@Icons.Material.Filled.ExpandLess">

                <MudNavLink Href="/dashboard">Business Reports</MudNavLink>
                <MudNavLink Href="/admin-dashboard">Staff Reports</MudNavLink>
                <MudNavLink Href="/users">Staff User Management</MudNavLink>

            </MudNavGroup>

        </Authorized>
    </AuthorizeView>

</MudNavMenu>
