@inherits LayoutComponentBase
@inject IDialogService Dialog
@using Cafe_Inventory_Management.UI.Services
@using MudBlazor
@inject NavigationManager Navigation
@inject AuthenticationStateProvider AuthenticationStateProvider

<MudThemeProvider IsDarkMode="false" />
<MudPopoverProvider />
<MudDialogProvider />
<MudSnackbarProvider />
@if (!IsLoginPage)
{
    <MudLayout>
        @if (!IsLoginPage)
        {
            @* Fixed App Bar for Dashboard *@
            <MudAppBar Elevation="1" Dense="true" Fixed="true"
                       Style="background-color: white; border-bottom: 1px solid #eee; z-index: 1300;">

                <MudText Typo="Typo.h6"
                         Style="font-weight:900; color:#1B1212; letter-spacing: 1px;">
                    CHANOHOLIC
                </MudText>

                <MudSpacer />

                <AuthorizeView>
                    <Authorized Context="auth">

                        <MudText Typo="Typo.body1" Class="mr-3" Style="color: #666;">
                            Welcome, <b>@auth.User.FindFirst(c => c.Type == "name")?.Value</b>
                        </MudText>

                        <MudButton OnClick="Logout"
                                   Variant="Variant.Outlined"
                                   Color="Color.Dark"
                                   StartIcon="@Icons.Material.Filled.Logout">
                            Logout
                        </MudButton>


                    </Authorized>
                </AuthorizeView>

            </MudAppBar>


            <MudDrawer Open="true" ClipMode="DrawerClipMode.Always" Elevation="2">
                <NavMenu />
            </MudDrawer>

            @* Dashboard Content Wrapper with Padding-Top *@
            <MudMainContent Style="background-color: #FAF9F6; min-height: 100vh;">
                <div  >
                    @Body
                </div>
            </MudMainContent>
        }
        else
        {
            @* Login Content: No App Bar, No Sidebar, No Padding, No White Box *@
            <MudMainContent Style="background-color: #111827;">
                @* Match your login background color *@
                @Body
            </MudMainContent>
        }
    </MudLayout>
}
else
{
        <MudLayout>
        @Body

</MudLayout>
}

@code {
    private bool IsLoginPage => Navigation.ToBaseRelativePath(Navigation.Uri) == "" ||
                                Navigation.ToBaseRelativePath(Navigation.Uri).ToLower().Contains("signin") ||
                                Navigation.ToBaseRelativePath(Navigation.Uri).ToLower().Contains("login");

    private async Task Logout()
    {
        bool? result = await Dialog.ShowMessageBox(
            "Confirm Logout",
            "Are you sure you want to logout?",
            yesText: "Logout",
            noText: "Cancel",
            options: new DialogOptions() { MaxWidth = MaxWidth.ExtraSmall, FullWidth = true }
        );

        if (result == true)
        {
            Navigation.NavigateTo("/", true); // perform logout
        }
    }
}