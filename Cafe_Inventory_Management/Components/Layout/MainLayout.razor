@inherits LayoutComponentBase
@inject IDialogService Dialog
@using Cafe_Inventory_Management.UI.Components.Pages
@using Cafe_Inventory_Management.UI.Services
@using MudBlazor
@inject NavigationManager Navigation
@inject AuthenticationStateProvider AuthenticationStateProvider

<MudThemeProvider IsDarkMode="false" Theme="_theme" />
<MudPopoverProvider />
<MudDialogProvider />
<MudSnackbarProvider />
@if (!IsLoginPage)
{
    <MudLayout>
        @if (!IsLoginPage)
        {
            <MudAppBar Elevation="1" Dense="true" Fixed="true" Class="appbar">

                <MudText Typo="Typo.h6"
                         Class="brand-title">
                    CHANOHOLIC            <MudImage Src="/Images/cf1.png" Width="30" Height="30" Alt="Product" Class="mr-3" />

                </MudText>

                <MudSpacer />

                <AuthorizeView>
                    <Authorized Context="auth">
                        <StockAlertBanner />

                        <MudText Typo="Typo.body1" Class="mr-3 user-name">
                             <b>@auth.User.FindFirst(c => c.Type == "name")?.Value</b>
                        </MudText>

                        <MudButton OnClick="Logout"
                                   Variant="Variant.Outlined"
                                   Color="Color.Dark"
                                   StartIcon="@Icons.Material.Filled.Logout">
                            Logout
                        </MudButton>


                    </Authorized>
                </AuthorizeView>

            </MudAppBar>


            <MudDrawer Open="true" ClipMode="DrawerClipMode.Always" Elevation="2" Class="drawer">
                <NavMenu />
            </MudDrawer>
            <MudMainContent Class="main-content">
                <div>
                    @Body
                </div>
            </MudMainContent>
        }
        else
        {
            <MudMainContent Style="background-color: #111827;">
                @Body
            </MudMainContent>
        }
    </MudLayout>
}
else
{
        <MudLayout>
        @Body

</MudLayout>
}

@code {
    private readonly MudTheme _theme = new()
    {
        PaletteLight = new PaletteLight
        {
            Primary = "#4b2e2b",
            PrimaryContrastText = "#ffffff",
            Secondary = "#6b4f4f",
            Background = "#faf7f2",
            Surface = "#ffffff",
            DrawerBackground = "#ffffff",
            DrawerText = "#1b1212",
            AppbarBackground = "#ffffff",
            AppbarText = "#1b1212",
            Divider = "rgba(17, 24, 39, 0.10)"
        }
    };

    private bool IsLoginPage => Navigation.ToBaseRelativePath(Navigation.Uri) == "" ||
                                Navigation.ToBaseRelativePath(Navigation.Uri).ToLower().Contains("signin") ||
                                Navigation.ToBaseRelativePath(Navigation.Uri).ToLower().Contains("login");

    private async Task Logout()
    {
        bool? result = await Dialog.ShowMessageBox(
            "Confirm Logout",
            "Are you sure you want to logout?",
            yesText: "Logout",
            noText: "Cancel",
            options: new DialogOptions() { MaxWidth = MaxWidth.ExtraSmall, FullWidth = true }
        );

        if (result == true)
        {
            Navigation.NavigateTo("/", true); // perform logout
        }
    }
}