@inherits LayoutComponentBase
@inject IDialogService Dialog
@using Cafe_Inventory_Management.UI.Components.Pages
@using Cafe_Inventory_Management.UI.Services
@using MudBlazor
@inject NavigationManager Navigation
@inject AuthenticationStateProvider AuthenticationStateProvider

<MudThemeProvider IsDarkMode="@_isDarkMode" Theme="_theme" />
<MudPopoverProvider />
<MudDialogProvider FullWidth="true" CloseButton="true" MaxWidth="MaxWidth.ExtraSmall" />
<MudSnackbarProvider />
<style>
    /* Premium Scrollbar Styling */
    ::-webkit-scrollbar {
        width: 8px;
        height: 8px;
    }
    ::-webkit-scrollbar-track {
        background: transparent;
    }
    ::-webkit-scrollbar-thumb {
        background: rgba(0, 0, 0, 0.1);
        border-radius: 10px;
    }
    ::-webkit-scrollbar-thumb:hover {
        background: rgba(0, 0, 0, 0.2);
    }
    
    .dark-mode-scrollbar::-webkit-scrollbar-thumb {
        background: rgba(255, 255, 255, 0.1);
    }

    /* Floating Pill Navbar */
    .appbar-pill {
        margin: 16px 24px !important;
        width: calc(100% - 48px) !important;
        border-radius: 50px !important;
        background: rgba(255, 255, 255, 0.9) !important;
        backdrop-filter: blur(12px) saturate(180%);
        -webkit-backdrop-filter: blur(12px) saturate(180%);
        border: 1px solid rgba(255, 255, 255, 0.3) !important;
        box-shadow: 0 10px 15px -3px rgba(0, 0, 0, 0.05), 0 4px 6px -2px rgba(0, 0, 0, 0.05) !important;
        height: 64px !important;
        left: 0 !important;
        right: 0 !important;
        color: #1e293b !important;
    }

    .dark .appbar-pill {
        background: rgba(18, 18, 18, 0.8) !important;
        border: 1px solid rgba(255, 255, 255, 0.08) !important;
        color: #f8fafc !important;
    }

    /* Brand Section */
    .brand-stack {
        margin-left: 8px;
    }

    /* Action Buttons - Orange Accent */
    .cta-btn-orange {
        background-color: #ff4d00 !important;
        color: white !important;
        border-radius: 30px !important;
        text-transform: none !important;
        font-weight: 600 !important;
        padding: 8px 20px !important;
    }

    .cta-btn-outline {
        border: 1px solid #e2e8f0 !important;
        border-radius: 30px !important;
        text-transform: none !important;
        font-weight: 600 !important;
        padding: 8px 20px !important;
    }

    /* Adjust layout for horizontal nav */
    .main-content-pill {
        padding-top: 100px !important;
        margin: 0 !important;
    }

    /* Horizontal Menu Styling */
    .nav-link-horizontal {
        font-weight: 600 !important;
        color: #475569 !important;
        text-transform: none !important;
        padding: 0 12px !important;
        transition: color 0.2s ease;
    }

    .nav-link-horizontal:hover {
        color: #0F172A !important;
        background: transparent !important;
    }

    .nav-menu-horizontal {
        font-weight: 600 !important;
        color: #475569 !important;
        text-transform: none !important;
    }

    .nav-menu-horizontal:hover {
        color: #0F172A !important;
    }

    .active-nav {
        color: #ff4d00 !important;
    }


</style>
@if (!IsLoginPage)
{
    <MudLayout>
        @if (!IsLoginPage)
        {
            <MudAppBar Elevation="0" Dense="true" Fixed="true" Class="appbar-pill">

                <MudStack Row="true" AlignItems="AlignItems.Center" Spacing="4">
                    <MudIconButton Icon="@Icons.Material.Filled.Menu" 
                                   Color="Color.Inherit" 
                                   Edge="Edge.Start" 
                                   OnClick="@(() => _drawerOpen = !_drawerOpen)" 
                                   Class="d-md-none" />

                    <MudStack Row="true" AlignItems="AlignItems.Center" Spacing="2" Class="brand-stack">
                        <MudIcon Icon="@Icons.Material.Filled.LocalCafe" Color="Color.Primary" Size="Size.Medium" />
                        <MudText Typo="Typo.h6" FontWeight="FontWeight.ExtraBold" Style="letter-spacing: -0.5px;">
                            CHANOHOLIC
                        </MudText>
                    </MudStack>
                </MudStack>

                <MudSpacer />

                @* Horizontal Navigation - Desktop Only *@
                <MudHidden Breakpoint="Breakpoint.MdAndDown">
                    <MudStack Row="true" AlignItems="AlignItems.Center" Spacing="0">
                        <MudButton Href="/pos" Class="nav-link-horizontal" Ripple="false">Point of Sale</MudButton>
                        
                        <MudMenu Label="Orders" 
                                 EndIcon="@Icons.Material.Filled.KeyboardArrowDown" 
                                 ActivationEvent="MouseEvent.MouseOver"
                                 AnchorOrigin="Origin.BottomCenter"
                                 TransformOrigin="Origin.TopCenter"
                                 Class="nav-menu-horizontal ms-2">
                            <MudMenuItem href="/ordersList">Order List</MudMenuItem>
                            <MudMenuItem href="/order-history">Order History</MudMenuItem>
                        </MudMenu>

                        <MudMenu Label="Inventory" 
                                 EndIcon="@Icons.Material.Filled.KeyboardArrowDown" 
                                 ActivationEvent="MouseEvent.MouseOver"
                                 AnchorOrigin="Origin.BottomCenter"
                                 TransformOrigin="Origin.TopCenter"
                                 Class="nav-menu-horizontal ms-2">
                            <MudMenuItem href="/product">Product List</MudMenuItem>
                            <MudMenuItem href="/Ingredients">Stock Control</MudMenuItem>
                            <MudDivider />
                            <MudMenuItem href="/product-import">Products Import</MudMenuItem>
                            <MudMenuItem href="/ingredient-import">Ingredients Import</MudMenuItem>
                        </MudMenu>

                        <AuthorizeView Roles="Admin">
                            <MudMenu Label="Administrations" 
                                     EndIcon="@Icons.Material.Filled.KeyboardArrowDown" 
                                     ActivationEvent="MouseEvent.MouseOver"
                                     AnchorOrigin="Origin.BottomCenter"
                                     TransformOrigin="Origin.TopCenter"
                                     Class="nav-menu-horizontal ms-2">
                                <MudMenuItem href="/dashboard">Business Reports</MudMenuItem>
                                <MudMenuItem href="/admin-dashboard">Staff Reports</MudMenuItem>
                                <MudMenuItem href="/users">Staff User Management</MudMenuItem>
                            </MudMenu>
                        </AuthorizeView>
                    </MudStack>
                </MudHidden>

                <MudSpacer />


                <MudToggleIconButton @bind-Toggled="@_isDarkMode"
                                   Icon="@Icons.Material.Filled.DarkMode"
                                   ToggledIcon="@Icons.Material.Filled.LightMode"
                                   Title="Toggle Dark Mode"
                                   Class="mr-2"
                                   Color="Color.Inherit" />


                <AuthorizeView>
                    <Authorized Context="auth">
                        <StockAlertBanner />

                        <MudLink Href="/profile" Underline="Underline.None" Color="Color.Inherit" Class="mr-3 user-name d-flex align-center">
                            <MudAvatar Color="Color.Primary" Size="Size.Small" Class="mr-2">
                                @(auth.User.FindFirst(c => c.Type == "name")?.Value?.FirstOrDefault() ?? 'U')
                            </MudAvatar>
                            <MudText Typo="Typo.body2" Class="fw-bold">
                                 @auth.User.FindFirst(c => c.Type == "name")?.Value
                            </MudText>
                        </MudLink>

                        <MudButton OnClick="Logout"
                                   Variant="Variant.Filled"
                                   Class="cta-btn-orange"
                                   StartIcon="@Icons.Material.Filled.Logout">
                            Logout
                        </MudButton>

                    </Authorized>
                </AuthorizeView>


            </MudAppBar>


            <MudDrawer @bind-Open="_drawerOpen" ClipMode="DrawerClipMode.Never" Elevation="1" Variant="DrawerVariant.Temporary">
                <NavMenu />
            </MudDrawer>

            <MudMainContent Class="main-content-pill">
                <MudContainer MaxWidth="MaxWidth.ExtraLarge" Class="px-6">
                    @Body
                </MudContainer>
            </MudMainContent>


        }
        else
        {
            <MudMainContent Style="background-color: #111827;">
                @Body
            </MudMainContent>
        }
    </MudLayout>
}
else
{
        <MudLayout>
        @Body

</MudLayout>
}

@code {
    private bool _drawerOpen = false;
    private bool _isDarkMode = false;


    private readonly MudTheme _theme = new()
    {
        PaletteLight = new PaletteLight
        {
            Primary = "#0F172A",
            PrimaryContrastText = "#ffffff",
            Secondary = "#475569",
            Background = "#F1F5F9",
            Surface = "#ffffff",
            DrawerBackground = "#ffffff",
            DrawerText = "#1E293B",
            AppbarBackground = "#ffffff",
            AppbarText = "#1E293B",
            Divider = "rgba(15, 23, 42, 0.08)",
            ActionDefault = "#475569"
        },
        PaletteDark = new PaletteDark
        {
            Primary = "#94A3B8",
            Secondary = "#64748B",
            Background = "#020617",
            Surface = "#0F172A",
            DrawerBackground = "#0F172A",
            DrawerText = "#F1F5F9",
            AppbarBackground = "#0F172A",
            AppbarText = "#F1F5F9",
            Divider = "rgba(255, 255, 255, 0.06)",
            ActionDefault = "#94A3B8"
        },
        LayoutProperties = new LayoutProperties
        {
            DefaultBorderRadius = "8px",
        }
    };


    private bool IsLoginPage => Navigation.ToBaseRelativePath(Navigation.Uri) == "" ||
                                Navigation.ToBaseRelativePath(Navigation.Uri).ToLower().Contains("signin") ||
                                Navigation.ToBaseRelativePath(Navigation.Uri).ToLower().Contains("login");

    private async Task Logout()
    {
        bool? result = await Dialog.ShowMessageBox(
            "Confirm Logout",
            "Are you sure you want to logout?",
            yesText: "Logout",
            noText: "Cancel",
            options: new DialogOptions() { MaxWidth = MaxWidth.ExtraSmall, FullWidth = true }
        );

        if (result == true)
        {
            Navigation.NavigateTo("/", true); // perform logout
        }
    }
}